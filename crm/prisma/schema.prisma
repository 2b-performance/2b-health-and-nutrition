// CRM — schema Prisma (SQLite)
// v1: Contatos + Pipeline de negócios + login simples.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  contacts Contact[]
  deals    Deal[]
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  deals Deal[]

  @@index([ownerId])
}

model Deal {
  id        String   @id @default(cuid())
  title     String
  // valor em centavos, para evitar erros de ponto flutuante
  valueCents Int     @default(0)
  // etapa do funil: NOVO | CONTATO | PROPOSTA | GANHO | PERDIDO
  stage     String   @default("NOVO")
  // ordem dentro da coluna do Kanban
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  @@index([ownerId])
  @@index([contactId])
  @@index([stage])
}
